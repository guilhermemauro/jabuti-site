---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import GitHubButton from "../../components/GitHubButton.astro";
import { getPosts, formatDate } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}/`, Astro.site).href;

const article = {
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { "@type": "Organization", name: post.data.author, url: "https://getjabuti.com/" },
  publisher: { "@type": "Organization", name: "Jabuti", url: "https://getjabuti.com/" },
  mainEntityOfPage: url,
  image: new URL("/og.png", Astro.site).href,
};
const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Jabuti", item: "https://getjabuti.com/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://getjabuti.com/blog/" },
    { "@type": "ListItem", position: 3, name: post.data.title, item: url },
  ],
};
---

<Base title={`${post.data.title} · Jabuti`} description={post.data.description} schema={[article, breadcrumbs]}>
  <article class="post">
    <header class="wrap post-head">
      <p class="post-meta">
        <a href="/blog/">Blog</a> ·
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    <div class="wrap prose">
      <Content />
    </div>
    <aside class="wrap post-cta">
      <div>
        <h2>Run it on your own data</h2>
        <p>Jabuti is free, open source and self-hosted. One command installs it on your server.</p>
      </div>
      <p class="ctas">
        <a class="btn btn-primary" href="/install/">Install Jabuti</a>
        <GitHubButton label="View on GitHub" />
      </p>
    </aside>
  </article>
</Base>

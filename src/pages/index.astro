---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Problems from "../components/Problems.astro";
import Workflow from "../components/Workflow.astro";
import Capabilities from "../components/Capabilities.astro";
import Install from "../components/Install.astro";
import Faq from "../components/Faq.astro";
import Developers from "../components/Developers.astro";
import Status from "../components/Status.astro";
import { faq } from "../data/faq";

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base schema={[faqSchema]}>
  <Hero />
  <Problems />
  <Workflow />
  <Capabilities />
  <Install />
  <Faq />
  <Developers />
  <Status />
</Base>

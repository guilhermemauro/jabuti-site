---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Pillars from "../components/Pillars.astro";
import Context from "../components/Context.astro";
import Autonomy from "../components/Autonomy.astro";
import Authority from "../components/Authority.astro";
import SearchModes from "../components/SearchModes.astro";
import Control from "../components/Control.astro";
import InstallCta from "../components/InstallCta.astro";
import Faq from "../components/Faq.astro";
import Developers from "../components/Developers.astro";
import Status from "../components/Status.astro";
import { faq } from "../data/faq";

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base schema={[faqSchema]}>
  <Hero />
  <Pillars />
  <Context />
  <Autonomy />
  <Authority />
  <SearchModes />
  <Control />
  <InstallCta />
  <Faq />
  <Developers />
  <Status />
</Base>

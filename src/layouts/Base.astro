---
import { Font } from "astro:assets";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import GitHubButton from "../components/GitHubButton.astro";
import { REPO, blob, SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const graph = [
  {
    "@type": "SoftwareApplication",
    "@id": `${Astro.site?.href}#software`,
    name: "Jabuti",
    description,
    url: Astro.site?.href,
    applicationCategory: "BusinessApplication",
    applicationSubCategory: "AI agent for SEO, AEO and GEO",
    operatingSystem: "Linux (Docker)",
    license: "https://opensource.org/licenses/MIT",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    downloadUrl: REPO,
    image: ogImage.href,
  },
  {
    "@type": "SoftwareSourceCode",
    name: "Jabuti",
    codeRepository: REPO,
    programmingLanguage: "TypeScript",
    license: "https://opensource.org/licenses/MIT",
  },
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Jabuti blog" href="/rss.xml" />
    <meta name="theme-color" content="#125238" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jabuti" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jabuti: an open source AI agent for SEO, AEO and GEO." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="wrap topbar-inner">
        <a class="brand" href="/" aria-label="Jabuti home">
          <Logo />
          <span class="brand-name">Jabuti</span>
        </a>
        <nav aria-label="Main">
          <a href="/#autonomy">How it works</a>
          <a href="/#seo-aeo-geo">SEO · AEO · GEO</a>
          <a class="nav-keep" href="/install/">Install</a>
          <a href="/blog/">Blog</a>
          <GitHubButton class="nav-gh" />
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <a class="brand" href="/" aria-label="Jabuti home">
          <Logo size="sm" />
          <span class="brand-name">Jabuti</span>
        </a>
        <nav aria-label="Footer">
          <a href="/install/">Install</a>
          <a href="/blog/">Blog</a>
          <a href="/rss.xml">RSS</a>
          <a href={REPO}>GitHub</a>
          <a href={blob("README.md")}>README</a>
          <a href={blob("AGENTS.md")}>AGENTS.md</a>
          <a href={blob("SECURITY.md")}>Security</a>
          <a href={blob("LICENSE")}>MIT License</a>
        </nav>
        <p class="muted">Slow to start, hard to break, and it always gets there.</p>
      </div>
    </footer>
  </body>
</html>

---
import { blob } from "../consts";

const tools = ["shell", "packages", "web_read", "page_structure", "site_crawl", "view_images", "delegate", "memory", "plan", "agents", "skill"];
const connectors = ["gsc", "ga4", "pagespeed", "serper", "dataforseo", "wikipedia", "nanobanana", "gptimage"];

const security = [
  ["One owner.", "Every API route and the WebSocket require the owner's session and refuse other origins."],
  ["Secrets in one process.", "Encrypted at rest (AES-256-GCM), never sent to the browser, the model or the shell."],
  ["Isolated shells.", "A separate runner container, one Unix user and workspace per agent, never as root."],
  ["Approvals.", "Risky commands, package installs, profile, skill and brief changes wait for you, with a diff or the exact arguments."],
];
---

<section class="section section-alt">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">What's inside</p>
      <h2>Batteries, listed.</h2>
    </header>
    <dl class="inside">
      <div>
        <dt>Built-in tools</dt>
        <dd>{tools.map((t) => <><code>{t}</code> </>)}</dd>
      </div>
      <div>
        <dt>Connectors</dt>
        <dd>{connectors.map((c) => <><code>{c}</code> </>)}plus any remote MCP server you register</dd>
      </div>
      <div>
        <dt>Skills</dt>
        <dd><code>data-study</code> (turn company or public data into a study others cite), plus your own</dd>
      </div>
      <div>
        <dt>Models</dt>
        <dd>Claude Opus, Sonnet, Haiku and Fable, through a provider-neutral loop</dd>
      </div>
    </dl>

    <div class="security">
      <h3>Security is part of the design</h3>
      <p>Jabuti runs code that a model writes, so:</p>
      <ul>{security.map(([head, text]) => <li><strong>{head}</strong> {text}</li>)}</ul>
      <p class="muted">
        Found a vulnerability? Report it privately, as described in
        <a href={blob("SECURITY.md")}>SECURITY.md</a>.
      </p>
    </div>
  </div>
</section>

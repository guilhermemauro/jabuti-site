---
// From the README's "Why Jabuti". Only claim what the README claims.
const features: { title: string; body: string }[] = [
  {
    title: "No agent framework",
    body: "No LangChain, LangGraph, CrewAI, Mastra or agent SDKs. The loop, tool registry, context management, permissions, skills loader and agent switching are plain TypeScript. The only libraries are the model API client, the MCP SDK, <code>zod</code>, React, a WebSocket server and Vitest.",
  },
  {
    title: "One agent per site or project",
    body: "Each agent is a profile on disk: model, system prompt, budget, tools, shell mode, subagents, MCP connectors and skills, with its own brief, notes and workspace. Switch agents mid-conversation: the history is shared, the capabilities are not.",
  },
  {
    title: "Real work in a shell",
    body: "Commands run in a Linux container with Python, one workspace per agent, with no secret from the server. Per agent and per conversation, they run on their own (<code>auto</code>) or wait for your approval on each (<code>ask</code>).",
  },
  {
    title: "Secrets stay in the server",
    body: "Keys and tokens are encrypted at rest and reach only the MCP connectors of the agents in their scope. The model never sees them, and the shell never inherits them, unless you mark a variable for an agent's shell.",
  },
  {
    title: "Anything that speaks MCP",
    body: "Built in: Google Search Console, Google Analytics 4, PageSpeed, Serper, DataForSEO, Wikipedia and image generation. Or register any remote MCP server, with a token header or an OAuth login, and pick which tools ask before each call.",
  },
  {
    title: "Skills, loaded only when needed",
    body: "A skill is a method in a Markdown file. The prompt lists only each skill's name and description; the full method enters the context when a task needs it.",
  },
  {
    title: "Memory you can read and edit",
    body: "A brief and dated notes in plain Markdown. After a conversation, a small model proposes what to remember, and nothing is saved until you approve it.",
  },
  {
    title: "Autonomy with a leash",
    body: "Milestones you approve, each change proposed as an experiment with a measured baseline, routines on a schedule. Unattended runs never get an approval: what they needed waits in your inbox. Changes ship as pull requests you merge.",
  },
  {
    title: "Long conversations that stay cheap",
    body: "Append-only history. Old tool results are cleared from the model's view (and saved to the workspace), and past a larger size the conversation is summarized. Request prefixes stay byte-identical between steps, so prompt caching holds.",
  },
];
---

<section id="why" class="section">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">Why Jabuti</p>
      <h2>The loop, written by hand.</h2>
      <p>
        Most agent stacks are a framework wrapped around a loop you never see. Jabuti is the loop,
        small enough to read in an afternoon, and strict about what an agent may do.
      </p>
    </header>
    <div class="cards">
      {
        features.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p set:html={f.body} />
          </article>
        ))
      }
    </div>
  </div>
</section>

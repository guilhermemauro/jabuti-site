---
import GitHubButton from "./GitHubButton.astro";
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="pills">
        <span class="pill">Free and open source</span>
        <span class="pill">Self-hosted</span>
        <span class="pill pill-warn">Early</span>
      </p>
      <h1>The AI agent that works on your SEO, AEO and GEO. Not just a chat.</h1>
      <p class="lede">
        Jabuti sees impressions, clicks and conversions for your whole business, works on a plan
        you approve instead of waiting for prompts, and publishes original studies that earn
        citations. Open source, on your own server.
      </p>
      <div class="ctas">
        <a class="btn btn-primary btn-lg" href="/install/">Install it free</a>
        <GitHubButton label="View on GitHub" class="btn-lg" />
      </div>
      <p class="hero-note">MIT license · Docker · Bring your own Anthropic API key</p>
    </div>

    {/* Illustrative: mirrors the plan tool (milestones, experiments, routine runs). No real data. */}
    <figure class="chat" aria-label="Illustration of a Jabuti agent's plan and inbox">
      <figcaption>
        <span class="dot"></span> blog <span class="muted">· plan</span>
      </figcaption>
      <div class="chat-body">
        <div class="plan-row">
          <span class="state state-done">approved</span>
          <span>Milestone: grow clicks from non-brand queries</span>
        </div>
        <div class="tool">
          <span class="tool-name">routine run</span>
          <span class="tool-out">measure: Search Console, by device, vs control pages</span>
        </div>
        <div class="tool">
          <span class="tool-name">mcp__dataforseo__ai_mentions</span>
          <span class="tool-out">which AI answers cite the site, and who they cite instead</span>
        </div>
        <div class="msg msg-agent">
          <p class="exp-title">Proposed experiment</p>
          <dl class="exp">
            <div><dt>Page</dt><dd><span class="bar"></span></dd></div>
            <div><dt>Hypothesis</dt><dd><span class="bar"></span></dd></div>
            <div><dt>Metric</dt><dd>CTR, by device</dd></div>
            <div><dt>Baseline</dt><dd><span class="bar bar-s"></span></dd></div>
            <div><dt>Checks</dt><dd>day 3 · 14 · 28</dd></div>
          </dl>
        </div>
        <div class="inbox">
          <span>Waiting in your inbox</span>
          <span class="inbox-actions"><span class="fake-btn">Review</span><span class="fake-btn fake-btn-primary">Approve</span></span>
        </div>
      </div>
      <p class="chat-foot">Illustration. Nothing goes live until you approve it.</p>
    </figure>
  </div>
</section>

---
import { faq } from "../data/faq";
---

<section id="faq" class="section section-alt">
  <div class="wrap faq-wrap">
    <header class="section-head">
      <p class="eyebrow">FAQ</p>
      <h2>Questions people ask.</h2>
    </header>
    <div class="faq">
      {
        faq.map((f, i) => (
          <details open={i === 0}>
            <summary>
              <h3>{f.q}</h3>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
